<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SystemInformation</RootNamespace>
    <StartupObject>SystemInformation.My.MyApplication</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <OptionStrict>On</OptionStrict>
    <MyType>WindowsForms</MyType>
    <ImportedNamespaces>JetBrains.Annotations=False,System.ComponentModel=False,System.Data=False,System.Drawing=False,System.Management=False,System.Runtime.InteropServices=False,System.Text=False,System.Windows.Forms=False,SystemInformation.CoreServices.UI=False,SystemInformation.Utilities.ErrorHandling=False,Microsoft.VisualBasic=True,System=True,System.Collections=True,System.Collections.Generic=True,System.Diagnostics=True,System.Linq=True,System.Xml.Linq=True,System.Threading.Tasks=True,SystemInformation=True</ImportedNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="JetBrains.Annotations" />
    <Import Include="System.ComponentModel" />
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Management" />
    <Import Include="System.Runtime.InteropServices" />
    <Import Include="System.Text" />
    <Import Include="System.Windows.Forms" />
    <Import Include="SystemInformation.CoreServices.UI" />
    <Import Include="SystemInformation.Utilities.ErrorHandling" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

</Project>